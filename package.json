{
  "name": "moviebox-desktop",
  "version": "1.0.0",
  "description": "MovieBox - movie & TV discovery app powered by TMDB",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.moviebox",
    "productName": "MovieBox",
    "files": ["main.js", "renderer/**/*", "package.json"],
    "win": { "target": ["portable"], "artifactName": "MovieBox.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "directories": { "output": "dist" }
  }
}
